<Application x:Class="AYVMPShaderInstaller.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#08090D"/>
        <SolidColorBrush x:Key="Panel" Color="#101219"/>
        <SolidColorBrush x:Key="Panel2" Color="#151821"/>
        <SolidColorBrush x:Key="Accent" Color="#78FF5B"/>
        <SolidColorBrush x:Key="Text" Color="#F4F7F2"/>
        <SolidColorBrush x:Key="Muted" Color="#8D958D"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#252A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
