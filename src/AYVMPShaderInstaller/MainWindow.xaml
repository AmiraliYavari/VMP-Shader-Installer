<Window x:Class="AYVMPShaderInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AY VMP Shader Installer" Width="980" Height="650" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AY VMP SHADER" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Installer &amp; Shader Pack Manager" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="Designed &amp; developed by Amirali Yavari" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="22" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Installation" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Select your VMP installation and a compatible shader pack." Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
                    <TextBlock Text="VMP / GTA V directory" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,8,0,18">
                        <Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click"/>
                        <TextBox x:Name="PathBox" Background="#0B0D12" Foreground="{StaticResource Text}" BorderBrush="#252A35" Padding="12" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Shader pack" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PackBox" Margin="0,8,0,20" Padding="8" Background="#0B0D12" Foreground="{StaticResource Text}" BorderBrush="#252A35"/>
                    <WrapPanel>
                        <Button Content="Detect VMP" Click="Detect_Click"/>
                        <Button Content="Install Pack" Background="#78FF5B" Foreground="#071006" BorderBrush="#78FF5B" Click="Install_Click"/>
                        <Button Content="Open Backup" Click="Backup_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Text="Ready. No changes have been made." Margin="0,22,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="16" Padding="22">
                <StackPanel>
                    <TextBlock Text="System status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="14" Margin="0,0,0,9"><DockPanel><TextBlock Text="VMP"/><TextBlock x:Name="VmpStatus" DockPanel.Dock="Right" Text="Not checked" Foreground="{StaticResource Muted}"/></DockPanel></Border>
                    <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="14" Margin="0,0,0,9"><DockPanel><TextBlock Text="Game directory"/><TextBlock x:Name="GameStatus" DockPanel.Dock="Right" Text="Not checked" Foreground="{StaticResource Muted}"/></DockPanel></Border>
                    <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="14" Margin="0,0,0,9"><DockPanel><TextBlock Text="Backup"/><TextBlock x:Name="BackupStatus" DockPanel.Dock="Right" Text="Automatic" Foreground="{StaticResource Accent}"/></DockPanel></Border>
                    <Separator Margin="0,16" Background="#252A35"/>
                    <TextBlock Text="About" FontWeight="SemiBold"/>
                    <TextBlock Text="A community-made installer framework for managing VMP shader packs. It does not include Rockstar or VMP files." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="AY • Amirali Yavari" Foreground="{StaticResource Accent}" Margin="0,14,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="AY VMP Shader Installer • Open source • Use only shader packs you have permission to distribute" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
    </Grid>
</Window>
