<Window x:Class="AYVMPShaderInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AY VMP Shader Installer" Width="1040" Height="720" MinWidth="900" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="AY VMP Shader Installer" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Install shader packs with automatic backup and restore." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Text="Developed by Amirali Yavari" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Game directory" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="The folder where shader files will be installed." Style="{StaticResource Caption}" Margin="0,3,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Grid.Column="0" TextChanged="PathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click"/>
                            <Button Grid.Column="2" Content="Detect" Margin="8,0,0,0" Click="Detect_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Open Folder" Padding="12,6" VerticalAlignment="Center" Click="OpenPacks_Click"/>
                            <StackPanel>
                                <TextBlock Text="Shader packs" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Select the pack you want to install." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="PackList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding FilesLabel}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyPacks" Text="No shader packs found." Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Create Backup" Padding="20,11" Margin="0,0,10,0" Click="CreateBackup_Click"/>
                    <Button Content="Install Pack" Style="{StaticResource PrimaryButton}" Padding="30,11" Click="Install_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Overview" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="DirStatus" DockPanel.Dock="Right" Text="Not set" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="Directory" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="GameStatus" DockPanel.Dock="Right" Text="-" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="Game files" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="PackCountText" DockPanel.Dock="Right" Text="0"/>
                            <TextBlock Text="Shader packs" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock x:Name="BackupCountText" DockPanel.Dock="Right" Text="0"/>
                            <TextBlock Text="Backups" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Backups" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Restore returns files to the state saved in the backup." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="BackupList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyBackups" Text="No backups yet." Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Restore Selected" Margin="0,0,8,0" Click="Restore_Click"/>
                            <Button Content="Open Folder" Click="OpenBackups_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12" Margin="0,16,0,0">
            <StackPanel>
                <ProgressBar x:Name="BusyBar" Height="3" Margin="0,0,0,10" BorderThickness="0"
                             Background="{StaticResource Line}" Foreground="{StaticResource Accent}"
                             IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="Use only shader packs you have permission to distribute." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
